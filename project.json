{
  "name": "guga-write",
  "projectName": "咕嘎写作",
  "machineReadableEntry": "project.json",
  "visibility": "private",
  "type": "project",
  "canonicalPurpose": "AI-assisted long-form novel writing workspace: write, review, publish.",
  "readOrder": [
    "ARCHITECTURE.md",
    "project.json"
  ],
  "defaultBranch": "main",
  "portability": "self-contained: runs from a fresh clone with no external services; all external endpoints are optional env vars",
  "dataRoot": "data/",
  "configurationSurfaces": [
    ".env (repo root, optional, gitignored)"
  ],
  "installEntry": {
    "packageManager": "pnpm",
    "install": "pnpm install",
    "build": "pnpm -r run build",
    "dev": "pnpm dev"
  },
  "status": "active",
  "healthPath": "/api/v1/health",
  "ports": {
    "web": 19200,
    "api": 19201,
    "publisher": 19202
  }
}
