{
  "name": "guga-write",
  "projectName": "咕嘎写作",
  "machineReadableEntry": "project.json",
  "githubRepo": "https://github.com/emptyinkpot/novel-writer",
  "visibility": "private",
  "type": "project",
  "owner": "emptyinkpot",
  "canonicalPurpose": "AI-assisted long-form novel writing workspace.",
  "readOrder": [
    "ARCHITECTURE.md",
    "project.json",
    "apps/api/.env.example"
  ],
  "defaultBranch": "main",
  "localSourceRoot": "E:\\My Project\\novel-writer",
  "preferredActiveServer": {
    "host": "SERVER_IP_REMOVED",
    "sourceRoot": "github:emptyinkpot/novel-writer#main",
    "runtimeRoot": "/data/coolify/applications/{coolify.resourceUuid}"
  },
  "configurationSurfaces": [
    "Coolify application .env",
    "apps/api/.env.example",
    "Dockerfile"
  ],
  "secretSurfaces": [
    "Coolify application .env"
  ],
  "installEntry": {
    "packageManager": "pnpm",
    "install": "pnpm install",
    "build": "pnpm --filter @guga-write/api build && pnpm --filter @guga-write/web build",
    "dev": "pnpm -r --parallel run dev"
  },
  "status": "active",
  "domainRole": "novel-writing-runtime",
  "publicUrl": "https://writer.example.invalid/",
  "publicHealthPath": "/api/v1/health",
  "publicPort": 19200
}
